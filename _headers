# El HTML no se cachea: estas pantallas cambian varias veces al día y a Javi le
# salía la versión anterior al recargar. Los .js y .css siguen con la caché que
# Netlify pone por defecto (revalidan por etag).
/*.html
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate

# La web del cliente todavia no es publica: que no la indexe nadie.
/sinc/*
  X-Robots-Tag: noindex, nofollow

# Netlify sirve los .webmanifest como octet-stream y Safari entonces no los lee:
# sin esto, al guardar la app en la pantalla de inicio no sale ni el nombre ni
# el icono. Se le dice el tipo a mano.
/concierge.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
/hub.webmanifest
  Content-Type: application/manifest+json; charset=utf-8
